# ============================================
# RAG Project - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# All values here match the defaults in config.py
# ============================================

# Google API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Model Configuration
# These match the defaults in config.py
EMBEDDING_MODEL_NAME=qwen3-embedding:0.6b
LLM_MODEL_NAME=gemini-2.0-flash

# LLM Settings
# Temperature: Controls randomness (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7
# Max retries for API calls
LLM_MAX_RETRIES=2

# Vector Store Settings
# Collection name in ChromaDB
COLLECTION_NAME=products_collection
# Default number of results to retrieve
DEFAULT_TOP_K=3
# Search type: "similarity" or "mmr"
VECTOR_STORE_SEARCH_TYPE=similarity

# Proxy Settings (Optional)
# Uncomment and set if you need proxy for Google API
# PROXY_URL=http://127.0.0.1:3067
# NO_PROXY=localhost,127.0.0.1,0.0.0.0

# CSV Loader Settings
# Encoding for CSV files (utf-8-sig supports Excel exports with BOM)
CSV_ENCODING=utf-8-sig

# Note: CSV_METADATA_COLUMNS is hardcoded in config.py as ["name", "category"]
# If you need to change it, modify config.py directly
